# Konfigurasi DEV lokal (copy jadi .env). Untuk deployment client lihat deploy/.env.example
MYSQLHOST=localhost
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=
MYSQLDATABASE=maxco_chat_im
PORT=3000

# ---- Push notification (FCM) live chat — opsional ----
# 'true' = kirim push ke device client saat pesan dari CRM masuk.
FCM_PUSH_ENABLED=false
# Isi DENGAN SALAH SATU cara di bawah (Firebase console ->
# Project settings -> Service accounts -> Generate new private key):
# 1) base64 dari isi file JSON (paling praktis untuk .env):
#    base64 -i service-account.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
# 2) isi file JSON langsung (satu baris)
FIREBASE_SERVICE_ACCOUNT_JSON=
# 3) path file JSON di mesin ini
FIREBASE_SERVICE_ACCOUNT_FILE=
# (opsional) Firebase project id; kosongkan kalau ikut dari file service account
FIREBASE_PROJECT_ID=
# API key that protects the REST endpoints (/api/chats, /api/client)
# and Socket.IO. STRONGLY RECOMMENDED in production (clients send it via the
# X-API-Key header, sockets via auth: { api_key: "..." }).
# Left empty = all endpoints open (development mode) - not recommended.
# Generate one with: openssl rand -hex 32
CHAT_API_KEY=

# ---- Online presence (CS and user online status) — opsional ----
# Detik menunggu sebelum socket CRM/app yang terputus dianggap offline,
# supaya reconnect singkat tidak membuat status berkedip. Default 10; 0 = tanpa tunggu.
PRESENCE_GRACE_SECONDS=10