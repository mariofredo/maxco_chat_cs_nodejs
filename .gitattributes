# Files that run on the Linux server: always LF, even in Windows checkouts
# (core.autocrlf=true) and in `git archive` exports. A CRLF install.sh fails
# on the server with "/usr/bin/env: 'bash\r': No such file or directory".
*.sh          text eol=lf
*.sql         text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
.env.example  text eol=lf
deploy/**     text=auto eol=lf
