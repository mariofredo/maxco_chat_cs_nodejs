# ============================================================================
# Maxco Chat CS configuration - copy this file to .env then fill in the values.
#   cp .env.example .env
# DO NOT commit the real .env to git.
# ============================================================================

# ---- Required: MySQL database ----
# When MySQL runs on the same server host, use host.docker.internal
# (or the IP / hostname of your database server).
MYSQLHOST=host.docker.internal
MYSQLPORT=3306
MYSQLUSER=maxco_chat
MYSQLPASSWORD=your_password_here
# The database name must match the one used to run 01_schema.sql
MYSQLDATABASE=maxco_chat_im

# ---- Application ports ----
# PORT     = port inside the container (what the app listens on)
# APP_PORT = port opened on the server, used by the CRM / frontend
PORT=3000
APP_PORT=3000

# ---- Optional ----
# Image tag used by compose.
# IMPORTANT: keep this IN SYNC with the tarball you loaded via docker load.
# If it points to an old version, compose will run the OLD image and the
# container will look "healthy" while still being the previous release.
APP_IMAGE=maxco-chat-cs:1.0.0
# API key that protects the REST endpoints (/api/chats, /api/client)
# and Socket.IO. STRONGLY RECOMMENDED in production (clients send it via the
# X-API-Key header, sockets via auth: { api_key: "..." }).
# Left empty = all endpoints open (development mode) - not recommended.
# Generate one with: openssl rand -hex 32
CHAT_API_KEY=

# Online presence (CS / user online status): seconds to wait before a CRM or
# app socket that dropped is shown as offline, so a short reconnect never
# flickers the status. Default 10; 0 = no waiting.
PRESENCE_GRACE_SECONDS=10

# Container timezone; keep it aligned with the MySQL server timezone so chat
# timestamps stay consistent.
TZ=Asia/Jakarta

# ----------------------------------------------------------------------------
# Push notification (FCM) for live chat - OPTIONAL
# Enable only when the client uses the mobile app with push notifications.
# ----------------------------------------------------------------------------
# 'true' = send a push to the client's devices when a message is sent from the
# CRM. 'false' / empty = push disabled, the service runs normally either way.
FCM_PUSH_ENABLED=false

# Firebase credentials. Get them from the Firebase console ->
# Project settings -> Service accounts -> Generate new private key.
# Fill in ONLY ONE of the three options below (priority: 1, then 2, then 3):
#
# Option 1 (recommended): base64 of the JSON file, as a single line.
#   base64 -i service-account.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
#
# Option 2: the raw JSON content, on a single line.
FIREBASE_SERVICE_ACCOUNT_JSON=
#
# Option 3: path to the file inside the container - if you use this option,
# put the file in this deploy/ folder and uncomment the volume in
# docker-compose.yml.
FIREBASE_SERVICE_ACCOUNT_FILE=
#
# (Optional) Firebase project id; leave empty to take it from the service account file.
FIREBASE_PROJECT_ID=
